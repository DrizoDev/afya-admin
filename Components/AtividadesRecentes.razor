<DashboardCard Titulo="Atividades Recentes"
               Subtitulo="Últimas movimentações da plataforma">

    <Menu>
        <MudMenuItem>Ver todas</MudMenuItem>
        <MudMenuItem>Marcar como lidas</MudMenuItem>
    </Menu>

    <ChildContent>

        <MudStack Spacing="0" Class="mt-3">

            @foreach (var atividade in Atividades)
            {
                <div class="d-flex align-start py-3">

                    <MudAvatar Size="Size.Medium"
                               Color="@atividade.Cor"
                               Variant="Variant.Filled"
                               Class="mr-3">

                        <MudIcon Icon="@atividade.Icone"
                                 Size="Size.Small" />

                    </MudAvatar>

                    <div style="flex:1;">

                        <MudText Typo="Typo.body2">
                            <strong>@atividade.Usuario</strong>
                            @atividade.Descricao
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Class="mud-text-secondary mt-1">
                            @atividade.Tempo
                        </MudText>

                    </div>

                </div>

                @if (atividade != Atividades.Last())
                {
                    <MudDivider />
                }
            }

        </MudStack>

    </ChildContent>

</DashboardCard>

@code {

    private readonly List<AtividadeRecente> Atividades = new()
    {
        new(
            "Mariana Souza",
            "adicionou um novo cliente.",
            "há 5 minutos",
            Icons.Material.Outlined.PersonAdd,
            Color.Primary
        ),

        new(
            "Ana Martins",
            "publicou um novo relatório.",
            "há 45 minutos",
            Icons.Material.Outlined.Description,
            Color.Success
        ),

        new(
            "João Silva",
            "atualizou as permissões do sistema.",
            "há 1 hora",
            Icons.Material.Outlined.Settings,
            Color.Warning
        ),

        new(
            "Carlos Lima",
            "atualizou o projeto Integração CRM.",
            "há 2 horas",
            Icons.Material.Outlined.Edit,
            Color.Info
        )
    };

    private record AtividadeRecente(
        string Usuario,
        string Descricao,
        string Tempo,
        string Icone,
        Color Cor
    );
}