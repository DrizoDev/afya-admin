            "João Silva",
            "JS",
            "Concluído",
            100
        ),

        new(
            "Aplicativo do Aluno",
            "Afya Digital",
            "Ana Martins",
            "AM",
            "Em andamento",
            58
        ),

        new(
            "Integração CRM",
            "Faculdade São Lucas",
            "Carlos Lima",
            "CL",
            "Pendente",
            34
        )
    };

    private Color ObterCorStatus(string status)
    {
        return status switch
        {
            "Concluído" => Color.Success,
            "Em andamento" => Color.Primary,
            "Pendente" => Color.Warning,
            _ => Color.Default
        };
    }

    private record ProjetoRecente(
        string Nome,
        string Cliente,
        string Responsavel,
        string Iniciais,
        string Status,
        int Progresso
    );
}