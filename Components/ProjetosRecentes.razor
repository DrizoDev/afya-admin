<DashboardCard Titulo="Projetos Recentes"
               Subtitulo="Acompanhe os projetos mais recentes">

    <Menu>
        <MudMenuItem>Ver todos os projetos</MudMenuItem>
        <MudMenuItem>Exportar dados</MudMenuItem>
    </Menu>

    <ChildContent>

        <MudTable Items="@Projetos"
                  Hover="true"
                  Elevation="0"
                  Class="mt-2">

            <HeaderContent>
                <MudTh>Projeto</MudTh>
                <MudTh>Cliente</MudTh>
                <MudTh>Responsável</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Progresso</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Projeto">
                    <MudText Typo="Typo.subtitle2">
                        @context.Nome
                    </MudText>
                </MudTd>

                <MudTd DataLabel="Cliente">
                    @context.Cliente
                </MudTd>

                <MudTd DataLabel="Responsável">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="1">

                        <MudAvatar Size="Size.Small"
                                   Color="Color.Primary">
                            @context.Iniciais
                        </MudAvatar>

                        <MudText Typo="Typo.body2">
                            @context.Responsavel
                        </MudText>

                    </MudStack>

                </MudTd>

                <MudTd DataLabel="Status">

                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@ObterCorStatus(context.Status)"
                             Variant="Variant.Text">

                        @context.Status

                    </MudChip>

                </MudTd>

                <MudTd DataLabel="Progresso">

                    <div style="min-width:120px;">

                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Spacing="2">

                            <MudProgressLinear Value="@context.Progresso"
                                               Color="Color.Primary"
                                               Rounded="true"
                                               Size="Size.Small"
                                               Style="width:90px;" />

                            <MudText Typo="Typo.caption">
                                @context.Progresso%
                            </MudText>

                        </MudStack>

                    </div>

                </MudTd>

            </RowTemplate>

        </MudTable>

    </ChildContent>

</DashboardCard>

@code {

    private readonly List<ProjetoRecente> Projetos = new()
    {
        new(
            "Portal Acadêmico",
            "Afya Educação",
            "Mariana Souza",
            "MS",
            "Em andamento",
            72
        ),

        new(
            "Dashboard Financeiro",
