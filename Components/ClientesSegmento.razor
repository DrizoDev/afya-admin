<DashboardCard Titulo="Clientes por Segmento"
               Subtitulo="Distribuição da base de clientes">

    <Menu>
        <MudMenuItem>Ver detalhes</MudMenuItem>
        <MudMenuItem>Exportar dados</MudMenuItem>
    </Menu>

    <ChildContent>

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.Center"
                  Spacing="5"
                  Class="mt-6">

            <!-- GRÁFICO DONUT -->
            <div style="
                width:190px;
                height:190px;
                border-radius:50%;
                position:relative;
                flex-shrink:0;
                background:conic-gradient(
                    #2563EB 0% 42%,
                    #7C3AED 42% 73%,
                    #10B981 73% 91%,
                    #F97316 91% 100%
                );">

                <!-- Centro branco do donut -->
                <div style="
                    position:absolute;
                    width:125px;
                    height:125px;
                    border-radius:50%;
                    background:var(--mud-palette-surface);
                    top:50%;
                    left:50%;
                    transform:translate(-50%, -50%);
                    display:flex;
                    flex-direction:column;
                    align-items:center;
                    justify-content:center;">

                    <MudText Typo="Typo.h5">
                        @TotalClientes.ToString("N0")
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Class="mud-text-secondary">
                        Total
                    </MudText>

                </div>

            </div>


            <!-- LEGENDA -->
            <MudStack Spacing="2">

                @foreach (var segmento in Segmentos)
                {
                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2">

                        <div style="@($"width:14px; height:14px; border-radius:50%; background:{segmento.CorHex}; flex-shrink:0;")">
                        </div>

                        <div>

                            <MudText Typo="Typo.body2">
                                @segmento.Nome
                            </MudText>

                            <MudText Typo="Typo.subtitle2">
                                @segmento.Percentual%
                            </MudText>

                        </div>

                    </MudStack>
                }

            </MudStack>

        </MudStack>

    </ChildContent>

</DashboardCard>


@code {

    [Parameter]
    public int TotalClientes { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<SegmentoCliente> Segmentos { get; set; }
        = Array.Empty<SegmentoCliente>();

}